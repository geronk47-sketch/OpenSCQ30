# 3. Add outbound packet.
p = ROOT / "packets" / "outbound.rs"
s = p.read_text()
if "set_volume_balance" not in s:
    s = s.replace(
        "        PostSleepAudio,\n",
        "        PostSleepAudio, VolumeBalance,\n",
        1,
    )
    s += """

/// Experimental: command format borrowed from another Soundcore model.
/// D1301 support has not yet been confirmed.
pub fn set_volume_balance(balance: VolumeBalance) -> packet::Outbound {
