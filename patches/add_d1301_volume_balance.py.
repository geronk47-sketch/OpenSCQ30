from pathlib import Path

ROOT = Path("lib/src/devices/soundcore/d1301")


def replace_once(path, old, new):
    p = Path(path)
    s = p.read_text()
    if new in s:
        return
    if old not in s:
        raise RuntimeError(f"Не найден фрагмент: {path}\n{old}")
    p.write_text(s.replace(old, new, 1))


# 1. Structure for balance.
p = ROOT / "structures.rs"
s = p.read_text()
if "pub struct VolumeBalance" not in s:
    s += """

/// Experimental volume balance setting.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub struct VolumeBalance(i8);

impl VolumeBalance {
    pub fn new(value: i8) -> Self {
        Self(value.clamp(-6, 6))
    }

    pub fn inner(&self) -> i8 {
        self.0
    }

    pub fn bytes(&self) -> [u8; 1] {
        [(self.0 + 100) as u8]
