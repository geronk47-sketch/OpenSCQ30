(module_dir / "setting_handler.rs").write_text("""
use async_trait::async_trait;
use openscq30_lib_has::Has;
use strum::IntoEnumIterator;

use crate::{
    api::settings::{Setting, SettingId, Value},
    devices::soundcore::{
        common::settings_manager::{SettingHandler, SettingHandlerResult},
        d1301::structures::VolumeBalance,
    },
    settings,
};

use super::VolumeBalanceSetting;

#[derive(Default)]
pub struct VolumeBalanceSettingHandler;

#[async_trait]
impl<T> SettingHandler<T> for VolumeBalanceSettingHandler
where
    T: Has<VolumeBalance> + Send,
{
    fn settings(&self) -> Vec<SettingId> {
        VolumeBalanceSetting::iter().map(Into::into).collect()
    }

    fn get(&self, state: &T, setting_id: &SettingId) -> Option<Setting> {
        let balance: &VolumeBalance = state.get();
        let setting: VolumeBalanceSetting = (*setting_id).try_into().ok()?;

        match setting {
            VolumeBalanceSetting::VolumeBalance => Some(Setting::I32Range {
                setting: settings::Range {
                    range: -6..=6,
                    step: 1,
                },
                value: balance.inner().into(),
            }),
        }
    }

    async fn set(
        &self,
        state: &mut T,
        setting_id: &SettingId,
        value: Value,
    ) -> SettingHandlerResult<()> {
        let setting: VolumeBalanceSetting = (*setting_id)
            .try_into()
            .expect("already filtered by SettingsManager");

        match setting {
            VolumeBalanceSetting::VolumeBalance => {
                *state.get_mut() = VolumeBalance::new(
                    i8::try_from(value.try_as_i32()?.clamp(-6, 6))
                        .expect("-6 to 6 fits in i8"),
                );
            }
        }
        Ok(())
    }
}
""".strip() + "\\n")

(module_dir / "state_modifier.rs").write_text("""
use async_trait::async_trait;
use openscq30_lib_has::Has;
use std::sync::Arc;
use tokio::sync::watch;

use crate::{
    api::device,
    devices::soundcore::{
        d1301::{self, structures::VolumeBalance},
        common::{packet::PacketIOController, state_modifier::StateModifier},
    },
};

pub struct VolumeBalanceStateModifier {
    packet_io: Arc<PacketIOController>,
}

impl VolumeBalanceStateModifier {
    pub fn new(packet_io: Arc<PacketIOController>) -> Self {
        Self { packet_io }
    }
}

#[async_trait]
impl<T> StateModifier<T> for VolumeBalanceStateModifier
where
    T: Has<VolumeBalance> + Clone + Send + Sync,
{
    async fn move_to_state(
        &self,
        state_sender: &watch::Sender<T>,
        target_state: &T,
    ) -> device::Result<()> {
        let target = target_state.get();

        {
            let state = state_sender.borrow();
            if state.get() == target {
                return Ok(());
            }
        }

        self.packet_io
            .send_with_response(
                &d1301::packets::outbound::set_volume_balance(*target),
            )
            .await?;

        state_sender.send_modify(|state| {
            *state.get_mut() = *target;
        });

        Ok(())
    }
}
""".strip() + "\\n")


# 5. Register the module in modules.rs.
p = ROOT / "modules.rs"
s = p.read_text()
if "mod volume_balance;" not in s:
    s = s.replace(
        "mod listening_mode;",
        "mod listening_mode;\\nmod volume_balance;",
        1,
    )

if "pub fn d1301_volume_balance" not in s:
    marker = "\\n}\\n"
    pos = s.rfind(marker)
    if pos < 0:
        raise RuntimeError("Не найден конец impl в modules.rs")
    method = """

    pub fn d1301_volume_balance(&mut self) {
        let packet_io = self.packet_io_controller().clone();
        self.module_collection()
            .add_d1301_volume_balance(packet_io);
    }
"""
    s = s[:pos] + method + s[pos:]

p.write_text(s)


# 6. Enable the module in the D1301 device builder.
p = Path("lib/src/devices/soundcore/d1301.rs")
s = p.read_text()
if "builder.d1301_volume_balance();" not in s:
    s = s.replace(
        "        builder.d1301_listening_mode();",
        "        builder.d1301_listening_mode();\\n"
        "        builder.d1301_volume_balance();",
        1,
    )
    p.write_text(s)

